APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Direct-messaging realtime. Leave as "null" to run on polling only (no key
# needed). Set to "ably" + add ABLY_KEY below to enable live delivery.
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Realtime via Ably (ably/laravel-broadcaster + @ably/laravel-echo). Free tier =
# 200 concurrent connections. The ROOT key lives server-side only and is never
# exposed to the browser; the client gets short-lived tokens from /broadcasting/auth.
ABLY_KEY=

# Client switch only — enables the Echo (ably-js) client at build time. Contains
# NO key. Blank → messenger runs on its polling fallback.
VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI / RAG engine — defaults to the keyless "mock" provider.
# Set AI_DEFAULT_PROVIDER=openai and OPENAI_API_KEY to use the real provider.
AI_DEFAULT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# OpenRouter fallback — used automatically when OpenAI fails, if enabled.
# Leave the key blank here; configure it in Admin → AI Settings (stored encrypted).
# The model chain is tried in order and always falls back to openrouter/auto.
AI_FALLBACK_ENABLED=false
# Which provider leads the chat chain: openai or openrouter (the other backs it up).
AI_FALLBACK_PRIMARY=openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_SECONDARY=google/gemini-2.0-flash-exp:free

# Embeddings can use a DIFFERENT provider than chat. When OpenAI is unavailable,
# set EMBEDDING_PROVIDER=jina (free, multilingual) and add JINA_API_KEY, then run
# `php artisan rag:reembed` to re-index the corpus with the new model.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Jina AI free embeddings (get a key at https://jina.ai — no credit card).
# Leave blank here; configure it in Admin → AI Settings (stored encrypted).
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSIONS=1024

# Embedding fallback: dual-embed the corpus with primary + secondary so RAG
# survives the primary embeddings API going down (e.g. OpenAI quota at midnight).
AI_EMBEDDING_FALLBACK_ENABLED=false
AI_EMBEDDING_FALLBACK_SECONDARY=jina

# Vector store — MySQL-native (embeddings stored in DB, cosine in PHP).
VECTOR_DB_DEFAULT=mysql

# RAG retrieval tuning (see config/rag.php).
RAG_CHUNKING_STRATEGY=recursive
RAG_CHUNK_SIZE=150
RAG_CHUNK_OVERLAP=40
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_CONTEXT_LENGTH=6000
RAG_CITATION_ENABLED=true
